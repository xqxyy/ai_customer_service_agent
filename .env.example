# DeepSeek 大模型配置：客服 Agent 的推理模型。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow Embedding 配置：RAG 检索时把文本转成向量。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_EMBED_DIM=1024

# Milvus 向量数据库配置：保存知识库切块向量。
# 当前本机测试使用外部 Milvus 容器，对应端口 19531。
MILVUS_URI=http://localhost:19531
MILVUS_DB_NAME=customer_service_rag
MILVUS_COLLECTION_NAME=customer_service_docs
MILVUS_REBUILD_COLLECTION=false
MILVUS_TIMEOUT_SECONDS=5

# 旧 SQLite 配置：保留给本地轻量调试或兼容历史代码。
CUSTOMER_SERVICE_DB_PATH=customer_service.db

# RAG 最低相关度阈值：低于该分数的命中会被过滤。
MIN_RAG_SCORE=0.60

# 数据库连接：作品集最终展示推荐使用 PostgreSQL，也可以临时切回 SQLite。
DATABASE_URL=sqlite:///./customer_service.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
